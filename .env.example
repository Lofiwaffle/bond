# Local development (`supabase start` / Touchbase). GitHub Pages uses the hosted project.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Hosted Bond project (GitHub Pages / Play):
# EXPO_PUBLIC_SUPABASE_URL=https://melmzlgzfcysbnvtuksv.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — never expose via EXPO_PUBLIC_
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
