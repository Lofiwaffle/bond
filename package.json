{
  "name": "bond",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.17",
    "expo-build-properties": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "~16.3.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.5",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "test:onboarding": "npx --yes tsx scripts/screenshot-onboarding.ts",
    "test:plus": "npx --yes tsx scripts/verify-bond-plus.ts",
    "test:ads": "npx --yes tsx scripts/verify-ads.ts",
    "test:google": "npx --yes tsx scripts/verify-google-auth.ts",
    "test:store-screens": "npx --yes tsx scripts/screenshot-store.ts",
    "test:startup": "npx --yes tsx scripts/verify-startup.ts",
    "test:production": "npx --yes tsx scripts/verify-production.ts",
    "test:release": "npx --yes tsx scripts/verify-production.ts && npx --yes tsx scripts/verify-ads.ts && npx --yes tsx scripts/verify-bond-plus.ts && npx --yes tsx scripts/verify-growth-hub.ts && npx --yes tsx scripts/verify-startup.ts",
    "build:android": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "private": true
}
